{
  "name": "omni-watermark-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "electron:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build && vite build --config vite.electron.config.ts && vite build --config vite.preload.config.ts",
    "start": "electron .",
    "smoke:electron": "powershell -ExecutionPolicy Bypass -File scripts/smoke-electron-start.ps1",
    "prepare:playwright-resources": "powershell -ExecutionPolicy Bypass -File scripts/prepare-playwright-resources.ps1",
    "sync:release-app": "powershell -ExecutionPolicy Bypass -File scripts/sync-release-app.ps1",
    "package:portable-folder": "npm run sync:release-app && powershell -ExecutionPolicy Bypass -File scripts/package-portable-folder.ps1 && npm run verify:portable-folder",
    "verify:portable-folder": "powershell -ExecutionPolicy Bypass -File scripts/verify-portable-folder.ps1",
    "smoke:portable-app": "node scripts/smoke-portable-app.mjs",
    "smoke:portable-shortcut": "powershell -ExecutionPolicy Bypass -File scripts/smoke-portable-shortcut.ps1",
    "smoke:portable-processing": "node scripts/smoke-portable-processing.mjs",
    "smoke:portable-unicode-paths": "node scripts/smoke-portable-unicode-paths.mjs",
    "smoke:portable-landscape-fallback": "node scripts/smoke-portable-landscape-fallback.mjs",
    "smoke:image-watermark": "tsx scripts/smoke-image-watermark.ts",
    "dist:win": "npm run prepare:playwright-resources && npm run build && electron-builder --win dir",
    "dist:win:portable": "npm run prepare:playwright-resources && npm run build && electron-builder --win portable"
  },
  "build": {
    "appId": "ai.omni.watermarkcleaner",
    "productName": "Omni Watermark Cleaner",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "dist-renderer/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/ffmpeg.exe"
    ],
    "extraResources": [
      {
        "from": "vendor/ms-playwright",
        "to": "ms-playwright",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Omni-Watermark-Cleaner-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@pilio/gemini-watermark-remover": "1.0.27",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^0.468.0",
    "playwright": "1.59.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.5.2",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^32.3.3",
    "electron-builder": "^26.15.3",
    "jsdom": "^25.0.1",
    "tsx": "^4.22.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "wait-on": "^8.0.1"
  }
}
